# Copy this file to .env and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# DATABASE SETUP — ISANG FILE LANG
# =============================================================================
# 1. Supabase Dashboard → SQL Editor → New query
# 2. Buksan ang file:  supabase/SETUP.sql
# 3. Kopyahin LAHAT → i-paste → RUN (minsan lang)
# 4. Ilagay ang URL at anon key sa .env sa itaas
# 5. npm run dev
